# Copy this file to .env and fill in what you need. Every variable is optional:
# with nothing set, the API uses local model files and the heuristic Tier 2 fallback.
# Variables below are read by configs/settings.py.

# --- Database (used only by training and data loading, not by the API) ---

# Full Postgres connection string, e.g. from Neon or Supabase (include ?sslmode=require).
# If set, it takes precedence over the DB_* variables below.
DATABASE_URL=

# Postgres host. Default: localhost.
# DB_HOST=localhost

# Postgres user. Default: postgres.
# DB_USER=postgres

# Postgres password. Secret. Code default when the variable is absent: postgres.
# An empty value here overrides that default with an empty password, so set a real value or delete this line.
DB_PASSWORD=

# Postgres database name. Default: customer_support_ticket.
# DB_NAME=customer_support_ticket

# Postgres port. Default: 5432.
# DB_PORT=5432

# Postgres SSL mode (for example "require" for Neon). Default: empty, meaning no sslmode in the URL.
# DB_SSLMODE=

# --- Tier 2 LLM providers (first one set wins: Groq, then OpenRouter, then OpenAI) ---

# Groq API key from https://console.groq.com. Secret. Primary Tier 2 provider.
GROQ_API_KEY=

# Groq model for Tier 2. Default: openai/gpt-oss-120b (Groq's recommended replacement for the
# deprecated llama-3.3-70b-versatile; available on the free developer plan). Unverified against the
# live API from this repo; if Groq rejects it, Tier 2 falls back to the next provider or the heuristic.
# GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter API key from https://openrouter.ai. Secret. Used only if GROQ_API_KEY is empty.
OPENROUTER_API_KEY=

# OpenAI API key from https://platform.openai.com. Secret. Used only if neither Groq nor OpenRouter is set.
OPENAI_API_KEY=

# --- Model bundles ---

# Public Hugging Face repo holding the three .pkl bundles, e.g. your-username/support-ops-models.
# Downloaded into models/ on first use when the files are missing locally.
HF_MODEL_REPO=

# --- API limits (in-memory, per instance) ---

# Max POST /triage_agent requests per client IP per minute. Default: 10. 0 disables the limit.
# TRIAGE_RATE_LIMIT_PER_MIN=10

# Max Tier-2 LLM calls per UTC day per instance. Default: 200. When used up, Tier 2 uses the heuristic fallback.
# TRIAGE_DAILY_LLM_CALLS=200

# Comma-separated origins allowed for cross-origin browser calls. Default: empty (same-origin only). "*" is ignored.
# CORS_ALLOW_ORIGINS=

# --- Not read by the code ---

# Remote FastAPI URL for Streamlit. Not defined in configs/settings.py and not read by any code in this repo.
# API_BASE_URL=
