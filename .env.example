# Option A: Neon / Supabase connection string (recommended for cloud)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: individual Postgres settings (local or managed)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=customer_support_ticket
DB_PORT=5432
DB_SSLMODE=

# Hugging Face model repo (public), e.g. your-username/support-ops-models
HF_MODEL_REPO=

# Optional: remote FastAPI URL for Streamlit to call (after Cloud Run deploy)
API_BASE_URL=
